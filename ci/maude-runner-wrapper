#!/bin/sh
set -eu

# Maude 3.5.1 on macOS prints its version but can retain the GitHub Actions
# output pipe instead of exiting. Tamarin probes `maude --version` before it
# starts the real interactive process, so answer that probe deterministically.
if [ "${1:-}" = "--version" ]; then
  echo "3.5.1"
  exit 0
fi

# The self-hosted runner passes its own high-numbered control sockets to child
# processes. Maude retains them and can wait indefinitely during shutdown.
# Preserve only the standard streams used by Tamarin's Maude protocol.
fd=3
while [ "$fd" -le 255 ]; do
  eval "exec ${fd}>&-" 2>/dev/null || true
  fd=$((fd + 1))
done

exec "$HOME/actions-runner-vcissuer/tools/maude-real" "$@"
