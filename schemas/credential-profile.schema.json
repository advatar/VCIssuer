{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eudi-fi:schema:credential-profile:0.1",
  "title": "EUDI Formal Issuer Credential Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "manifest_digest",
    "issuer_role",
    "credential_configuration_id",
    "credential_type",
    "rulebook",
    "format",
    "device_binding",
    "subject_evidence_policy",
    "status_profile",
    "algorithm_suite",
    "validity_policy",
    "retention_policy"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer_role": {
      "enum": [
        "PID",
        "QEAA",
        "PublicBodyEAA",
        "NonQualifiedEAA"
      ]
    },
    "credential_configuration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "credential_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "vct": {
          "type": "string",
          "maxLength": 1024
        },
        "doc_type": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "rulebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "format": {
      "enum": [
        "SdJwtVcHaip1",
        "MdocIso18013_5"
      ]
    },
    "device_binding": {
      "enum": [
        "Required",
        "Recommended",
        "Forbidden"
      ]
    },
    "subject_evidence_policy": {
      "type": "string",
      "minLength": 1
    },
    "status_profile": {
      "type": "string",
      "minLength": 1
    },
    "algorithm_suite": {
      "type": "string",
      "minLength": 1
    },
    "validity_policy": {
      "type": "string",
      "minLength": 1
    },
    "batch_policy": {
      "type": "string"
    },
    "reuse_policy": {
      "type": "string"
    },
    "refresh_policy": {
      "type": "string"
    },
    "retention_policy": {
      "type": "string",
      "minLength": 1
    },
    "maximum_wire_sizes": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16777216
      }
    }
  }
}
