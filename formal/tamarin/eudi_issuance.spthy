/*
 * EUDI Formal Issuer: minimal Tamarin seed.
 *
 * This model captures only a small authentication/binding core. A production
 * theory must model PAR/PKCE, authorization codes, DPoP nonces and replay,
 * WIA/KA chains and status freshness, browser/cross-device boundaries,
 * refresh/reissue, batch/deferred issuance, and explicit corruption cases.
 */

theory EudiIssuance
begin

builtins: signing, hashing

functions:
  token/4,
  proof/4,
  credential/6

/* Public issuer signing key setup. */
rule RegisterIssuer:
  [ Fr(~skI) ]
  --[ IssuerRegistered($I, pk(~skI)) ]->
  [ !IssuerKey($I, ~skI), Out(pk(~skI)) ]

/* Abstract authorization result after the full PAR/authorization-code checks. */
rule RecordAuthorization:
  [ In(<'authorize', $I, $W, $Profile, $Subject, $Dataset, $DpopPk>) ]
  --[ Authorized($I, $W, $Profile, $Subject, $Dataset, $DpopPk) ]->
  [ !Authorization($I, $W, $Profile, $Subject, $Dataset, $DpopPk) ]

/* Abstract WIA/KA/subject evidence accepted under a fresh policy decision. */
rule RecordEvidence:
  [ In(<'evidence', $I, $W, $Profile, $Subject, $HolderPk>) ]
  --[ EvidenceAccepted($I, $W, $Profile, $Subject, $HolderPk) ]->
  [ !ValidEvidence($I, $W, $Profile, $Subject, $HolderPk) ]

/* DPoP-bound token creation. */
rule IssueToken:
  [ !Authorization($I, $W, $Profile, $Subject, $Dataset, $DpopPk),
    Fr(~tok) ]
  --[ TokenIssued($I, $W, $Profile, $Subject, $Dataset, $DpopPk, ~tok) ]->
  [ TokenState($I, $W, $Profile, $Subject, $Dataset, $DpopPk, ~tok),
    Out(token($I, $W, $DpopPk, ~tok)) ]

/* Credential issuance requires matching authorization, token, evidence,
 * holder-key proof and a fresh credential identifier. */
rule IssueCredential:
  [ !IssuerKey($I, ~skI),
    !Authorization($I, $W, $Profile, $Subject, $Dataset, $HolderPk),
    TokenState($I, $W, $Profile, $Subject, $Dataset, $HolderPk, ~tok),
    !ValidEvidence($I, $W, $Profile, $Subject, $HolderPk),
    In(proof($I, ~tok, $HolderPk, $Nonce)),
    Fr(~cid) ]
  --[ CredentialIssued($I, $W, $Profile, $Subject, $Dataset, $HolderPk, ~cid),
      NonceAccepted($I, $W, $Nonce) ]->
  [ Out(sign(credential($I, $Profile, $Subject, $Dataset, $HolderPk, ~cid), ~skI)) ]

/* Explicit issuer key compromise. */
rule RevealIssuerKey:
  [ !IssuerKey($I, ~skI) ]
  --[ IssuerKeyCompromised($I) ]->
  [ Out(~skI) ]

/* FI-PROT-001 seed. */
lemma issuance_requires_matching_authorization:
  "All I W Profile Subject Dataset HolderPk Cid #i.
     CredentialIssued(I, W, Profile, Subject, Dataset, HolderPk, Cid) @ #i
     ==> (Ex #j.
            Authorized(I, W, Profile, Subject, Dataset, HolderPk) @ #j
            & #j < #i)"

/* Evidence must also precede issuance. */
lemma issuance_requires_matching_evidence:
  "All I W Profile Subject Dataset HolderPk Cid #i.
     CredentialIssued(I, W, Profile, Subject, Dataset, HolderPk, Cid) @ #i
     ==> (Ex #j.
            EvidenceAccepted(I, W, Profile, Subject, HolderPk) @ #j
            & #j < #i)"

/* Credential IDs generated by the issuer are unique across issue events. */
lemma credential_identifier_injective:
  "All I1 I2 W1 W2 P1 P2 S1 S2 D1 D2 K1 K2 Cid #i #j.
     CredentialIssued(I1, W1, P1, S1, D1, K1, Cid) @ #i
     & CredentialIssued(I2, W2, P2, S2, D2, K2, Cid) @ #j
     ==> #i = #j"

end
